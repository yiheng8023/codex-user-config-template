{
  "schema_version": 1,
  "kind": "codex-user-config-template",
  "public_safe": true,
  "private_repository_required": true,
  "template_profile": {
    "name": "example-user",
    "language": "en"
  },
  "optional_inputs": {
    "skill_policy_source": "https://github.com/example/reviewed-skill-policy"
  },
  "safety": {
    "contains_real_memory": false,
    "contains_credentials": false
  },
  "managed_paths": [
    "AGENTS.md",
    "config/",
    "docs/",
    "hooks/",
    "memory/",
    "skills/"
  ],
  "excluded_from_public_template": [
    "real_memory_snapshots",
    "credentials",
    "oauth_state",
    "session_state",
    "local_machine_paths",
    "personal_preferences",
    "runtime_logs"
  ]
}
